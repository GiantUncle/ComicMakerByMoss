# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.venv/
venv/
.env
.env.*

# Node / frontend build
node_modules/
dist/
build/
*.tsbuildinfo

# App-generated / user project data
projects/

# The skill library is SHIPPED CODE, not local state. .opencode/skills must be
